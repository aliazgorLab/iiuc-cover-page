# Server Port & Mode
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/iiuc_cover_page

# JWT Session Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Application URL (Vercel deployment)
FRONTEND_URL=https://your-vercel-domain.vercel.app

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Development Only — Auto-promote designated account to SUPER_ADMIN during local development (Ignored in production)
DEV_SUPER_ADMIN_EMAIL=c233093@ugrad.iiuc.ac.bd


