# =====================================================================
# IIUC Cover Page Platform — Frontend Environment Configuration Template
# NOTE: Copy this file to .env.local for local development. Never commit real secrets.
# =====================================================================

# Existing Google OAuth Client ID (Preserved for backward-compatible fallback)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Existing Backend API Endpoint (Render Web Service)
VITE_API_URL=http://localhost:5000/api/v1

# Firebase Web Client Configuration (Target Platform)
# Note: Firebase Web API keys identify the Firebase project on Google servers.
# They are public-facing client identifiers, restricted via HTTP referrers and Firestore Security Rules.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id:web:your_hash
