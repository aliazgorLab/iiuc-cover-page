# =====================================================================
# IIUC Cover Page Platform — Frontend Environment Configuration Template
# NOTE: Copy this file to .env.staging.local (for staging) or .env.local (for dev).
# NEVER commit real credentials, service account keys, or environment files.
# =====================================================================

# Existing Google OAuth Client ID (Legacy sign-in fallback)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Existing Backend API Endpoint (Local dev: http://localhost:5000/api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# ---------------------------------------------------------------------
# Firebase Staging Web Client Configuration (Project: iiuc-cover-page-staging)
# ---------------------------------------------------------------------
# Application Environment Mode ('staging' or 'production')
VITE_APP_ENV=staging

# Staging Project ID (Must be exactly 'iiuc-cover-page-staging' — fail-closed enforced)
VITE_FIREBASE_PROJECT_ID=iiuc-cover-page-staging

# Staging Auth Domain and Storage Bucket
VITE_FIREBASE_AUTH_DOMAIN=iiuc-cover-page-staging.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=iiuc-cover-page-staging.firebasestorage.app

# Staging Web App Credentials (obtain from Firebase Console -> iiuc-cover-page-staging -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=your_staging_firebase_api_key_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_staging_messaging_sender_id_here
VITE_FIREBASE_APP_ID=1:your_staging_messaging_sender_id:web:your_staging_app_hash
