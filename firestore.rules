rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // IIUC Cover Page Platform — Firestore Security Rules
    // Principle of Least Privilege: Deny by default. Strictly enforce ownership,
    // institutional identity verification, and role-based administration.
    // =========================================================================

    // Global default fallback: Deny all unhandled operations
    match /{document=**} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Security Functions
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        ('mongoId' in request.auth.token && request.auth.token.mongoId == userId)
      );
    }

    function isAdmin() {
      return isSignedIn() &&
        'role' in request.auth.token && (
          request.auth.token.role == 'ADMIN' ||
          request.auth.token.role == 'SUPER_ADMIN' ||
          request.auth.token.role == 'MODERATOR'
        );
    }

    function isAcademicEmail() {
      return isSignedIn() &&
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) && (
          request.auth.token.email.matches('.*@ugrad\\.iiuc\\.ac\\.bd$') ||
          request.auth.token.email.matches('.*@student\\.iiuc\\.ac\\.bd$') ||
          request.auth.token.email.matches('.*@iiuc\\.ac\\.bd$')
        );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // User Profiles (`users/{userId}`)
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Students can only read their own profile; Admins can read all for governance
      allow read: if isOwner(userId) || isAdmin();

      // Creation is allowed if authenticated student matches document ID & verified domain
      allow create: if isOwner(userId) && isAcademicEmail() &&
        // Prevent student self-assigning admin roles, permissions, or unverified status
        (!('role' in request.resource.data) || request.resource.data.role == 'STUDENT') &&
        (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'ACTIVE') &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions.size() == 0);

      // Update: Students can edit academic info (dept, batch, etc.) but cannot elevate role/permissions
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'studentId', 'department', 'batch', 'semester', 'section', 'academicProfile', 'academicInfo', 'avatar', 'updatedAt'])
        || isAdmin();

      // Deletion is strictly reserved for Super Admin via server-side Admin SDK
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Generated Covers (`covers/{coverId}`)
    // ─────────────────────────────────────────────────────────────────────────
    match /covers/{coverId} {
      // Owner can view their own covers; Admins can view for analytics
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Only signed-in student can save covers under their own UID or verified legacy mongoId
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        ('mongoId' in request.auth.token && request.resource.data.userId == request.auth.token.mongoId)
      ) && request.resource.data.keys().hasAll(['templateId', 'coverType', 'coverData', 'userId']);

      // Owner can update cover data (e.g. rename or edit draft data), cannot transfer ownership
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId;

      // Owner can delete their own saved cover; Admin can moderate
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Auto-Saved Drafts (`drafts/{draftId}`)
    // ─────────────────────────────────────────────────────────────────────────
    match /drafts/{draftId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        ('mongoId' in request.auth.token && request.resource.data.userId == request.auth.token.mongoId)
      );
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Lab Index Records (`labIndexRecords/{recordId}`)
    // ─────────────────────────────────────────────────────────────────────────
    match /labIndexRecords/{recordId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        ('mongoId' in request.auth.token && request.resource.data.userId == request.auth.token.mongoId)
      );
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Public Academic Catalogs (Read-Only to Students/Guests, Write by Admin)
    // ─────────────────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true; // Publicly readable for cover generator autocompletion
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if true; // Publicly readable for cover generator teacher selector
      allow write: if isAdmin();
    }

    match /templates/{templateId} {
      allow read: if true; // Publicly readable cover page templates
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if true; // Publicly readable university departments & brand colors
      allow write: if isAdmin();
    }

    match /labexperiments/{experimentId} {
      allow read: if true; // Publicly readable lab experiment catalog
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Administrative Audit & Governance Logs (Restricted to Admins)
    // ─────────────────────────────────────────────────────────────────────────
    match /adminActivities/{activityId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /adminNotifications/{notifId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /broadcastLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /teacherImportLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /userSessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin(); // Logged via trusted backend / serverless trigger
    }
  }
}
